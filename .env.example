# API / Services
# Public backend base URL. FE checkout redirect/result polling expects the BE
# to expose /api/subscription and the /api/subscription/vnpay/* callbacks.
NEXT_PUBLIC_API_BASE_URL=/api
BACKEND_HEALTH_URL=
# Legacy direct query endpoint (still supported as fallback)
NEXT_PUBLIC_WEAVEY_API_URL=
NEXT_PUBLIC_RAG_API_BASE_URL=https://weavecarbon.com/rag
NEXT_PUBLIC_RAG_COLLECTION=
NEXT_PUBLIC_RAG_COLUMNS_TO_ANSWER=chunk
NEXT_PUBLIC_RAG_NUMBER_DOCS_RETRIEVAL=3
NEXT_PUBLIC_RAG_TIMEOUT_MS=30000
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_GEOCODING_BASE_URL=https://api.mapbox.com/geocoding/v5/mapbox.places
SEA_ROUTING_PROVIDER=dataloy
DATALOY_DISTANCES_API_KEY=
DATALOY_DISTANCES_BASE_URL=https://distances.dataloy.com
SEA_ROUTING_DISTANCE_UNIT=nautical_miles

# Auth
NEXT_PUBLIC_AUTH_DISABLED=0
