JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URLS=https://weavecarbon.com,https://www.weavecarbon.com
CORS_ORIGIN=https://weavecarbon.com,https://www.weavecarbon.com
AUTH_COOKIE_DOMAIN=weavecarbon.com
RAG_PROXY_ALLOWED_BASE_URLS=https://weavecarbon.com/rag,https://www.weavecarbon.com/rag
RAG_PROXY_INTERNAL_BASE_URL=http://rag:8000
RAG_INTERNAL_API_KEY=change_me_long_random_internal_secret
RAG_REQUIRE_INTERNAL_API_KEY=true
RAG_CORS_ORIGINS=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=change_me_email_user
EMAIL_PASSWORD=change_me_email_password
EMAIL_FROM=change_me_email_from

NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_APP_PUBLIC_URL=https://weavecarbon.com
BACKEND_HEALTH_URL=http://be:4000/health
AI_CONFIG_CONSOLE_ENABLED=0

NEXT_PUBLIC_WEAVEY_API_URL=
NEXT_PUBLIC_RAG_API_BASE_URL=https://weavecarbon.com/rag
NEXT_PUBLIC_RAG_COLLECTION=
