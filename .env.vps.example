# Public entrypoint
APP_DOMAIN=example.com,www.example.com
APP_PUBLIC_URL=https://example.com

# Repo layout on the VPS
BACKEND_REPO_PATH=../BE_Carbon-main

# Docker stack
TZ=Asia/Bangkok

# PostgreSQL
POSTGRES_DB=weavecarbon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origins allowed by the backend
FRONTEND_URLS=https://example.com,https://www.example.com
CORS_ORIGIN=https://example.com,https://www.example.com

# SMTP for email verification and password reset
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM=your-email@example.com

# FE build-time public config
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WEAVEY_API_URL=
NEXT_PUBLIC_RAG_API_BASE_URL=
NEXT_PUBLIC_RAG_COLLECTION=
NEXT_PUBLIC_RAG_COLUMNS_TO_ANSWER=chunk
NEXT_PUBLIC_RAG_NUMBER_DOCS_RETRIEVAL=3
NEXT_PUBLIC_RAG_TIMEOUT_MS=30000
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_GEOCODING_BASE_URL=https://api.mapbox.com/geocoding/v5/mapbox.places
NEXT_PUBLIC_AUTH_DISABLED=0
NEXT_PUBLIC_ACCOUNT_ENDPOINT=
NEXT_PUBLIC_ENFORCE_CLIENT_ROLE_GUARD=0

# FE runtime-only health check
BACKEND_HEALTH_URL=http://be:4000/health

# VNPay
VNPAY_MODE=mock
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERYDR_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
