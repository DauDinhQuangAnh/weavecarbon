{$APP_DOMAIN} {
  encode zstd gzip

  @backend path /api/* /health /ready /version
  handle @backend {
    reverse_proxy weavecarbon-be-1:4000
  }

  handle {
    reverse_proxy weavecarbon-fe-1:3000
  }
}

# Host-specific routes live in ignored *.local.caddy files so production
# co-tenants do not leave tracked WeaveCarbon files dirty.
import /etc/caddy/extra-sites/*.caddy
