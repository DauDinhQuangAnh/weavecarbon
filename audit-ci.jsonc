{
  // Dependency vulnerability gate for CI (replaces bare `npm audit --audit-level=high`).
  //
  // Build FAILS on any high/critical advisory that is NOT listed below, so newly
  // published vulnerabilities still block the pipeline.
  //
  // Everything in `allowlist` is a known advisory with NO non-breaking patched release
  // available at the time of writing (2026-07-30).
  //
  // ACTION: periodically re-run `npx audit-ci --config ./audit-ci.jsonc` locally.
  // - If an entry's `fixAvailable` is a plain `true` (non-major), upgrade that
  //   dependency instead of leaving it here.
  // - If an entry no longer appears in the report (advisory downgraded below "high"
  //   or a non-breaking fix shipped), delete it.
  // - Do not add new entries without the same "no non-breaking fix exists" check.
  "high": true,
  "allowlist": [
    // --- next (patched release requires a semver-major-adjacent bump; verify build
    // before upgrading — not verified in this pass) ---
    "GHSA-6gpp-xcg3-4w24", // Middleware / Proxy bypass (App Router + Turbopack, single locale)
    "GHSA-m99w-x7hq-7vfj", // Denial of Service in App Router using Server Actions
    "GHSA-89xv-2m56-2m9x", // SSRF in Server Actions on custom servers
    "GHSA-p9j2-gv94-2wf4", // SSRF in rewrites via attacker-controlled destination hostname

    // --- postcss (bundled under next/node_modules, not directly upgradable) ---
    "GHSA-6g55-p6wh-862q", // Arbitrary file read via attacker-controlled sourceMappingURL
    "GHSA-r28c-9q8g-f849", // Path traversal in sourceMappingURL auto-loading (.map disclosure)

    // --- sharp (transitive via next image optimization) ---
    "GHSA-f88m-g3jw-g9cj", // Inherited libvips CVEs (CVE-2026-33327/33328/35590/35591)

    // --- brace-expansion (via minimatch, pulled in by eslint tooling and
    // exceljs>archiver>readdir-glob) — fix requires a semver-major eslint bump
    // (10.8.0) or a downgrade of exceljs; neither is a non-breaking fix today ---
    "GHSA-mh99-v99m-4gvg" // Regular Expression Denial of Service (ReDoS)
  ]
}
